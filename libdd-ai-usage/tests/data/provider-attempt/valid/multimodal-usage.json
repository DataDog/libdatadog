{
  "$schema": "../../../../schema/provider-attempt-metric-fixture.schema.json",
  "profile": "gen_ai.client.provider_attempt@0.1.0",
  "case": "multimodal-usage",
  "description": "The upstream example of 100 text tokens and 200 image tokens: one increment per reported modality. The input parts cover the total, so it has no unknown increment. The output parts cover 30 of 50, so 20 are unknown.",
