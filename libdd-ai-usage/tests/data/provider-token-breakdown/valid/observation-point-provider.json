{
  "$schema": "../../../../schema/provider-token-breakdown-metric-fixture.schema.json",
  "profile": "trajectory.gen_ai.client.token_breakdown@0.1.0",
  "case": "observation-point-provider",
  "description": "The contract's own example (12000 input, 8000 cache reads, 3000 cache writes as 1000 and 2000 by lifetime, so 1000 uncached), recorded from a provider's records with observation_point: provider. Every point carries trajectory.observation.point.",
  "observation": {
    "operation_name": "chat",
    "provider_name": "exampleai",
    "request_model": "ex-large-1",
    "input_tokens": 12000,
    "output_tokens": 50,
    "input_basis": "includes_cache",
    "cache_read_input_tokens": 8000,
    "cache_write_input_tokens": 3000,
    "cache_write_5m_input_tokens": 1000,
    "cache_write_1h_input_tokens": 2000,
    "observation_point": "provider"
  },
  "expected_metrics": [
    {
      "name": "gen_ai.client.inference.usage.cache_read.input_tokens",
      "instrument": "counter",
      "unit": "{token}",
      "value": 8000,
      "attributes": {
        "gen_ai.operation.name": "chat",
        "gen_ai.provider.name": "exampleai",
        "gen_ai.request.model": "ex-large-1",
        "gen_ai.token.modality": "unknown",
        "trajectory.observation.point": "provider"
      }
    },
    {
      "name": "gen_ai.client.inference.usage.cache_write.input_tokens",
      "instrument": "counter",
      "unit": "{token}",
      "value": 2000,
      "attributes": {
        "gen_ai.operation.name": "chat",
        "gen_ai.provider.name": "exampleai",
        "gen_ai.request.model": "ex-large-1",
        "gen_ai.token.modality": "unknown",
        "trajectory.cache.lifetime": "1h",
        "trajectory.observation.point": "provider"
      }
    },
    {
      "name": "gen_ai.client.inference.usage.cache_write.input_tokens",
      "instrument": "counter",
      "unit": "{token}",
      "value": 1000,
      "attributes": {
        "gen_ai.operation.name": "chat",
        "gen_ai.provider.name": "exampleai",
        "gen_ai.request.model": "ex-large-1",
        "gen_ai.token.modality": "unknown",
        "trajectory.cache.lifetime": "5m",
        "trajectory.observation.point": "provider"
      }
    },
    {
      "name": "trajectory.gen_ai.client.inference.usage.uncached.input_tokens",
      "instrument": "counter",
      "unit": "{token}",
      "value": 1000,
      "attributes": {
        "gen_ai.operation.name": "chat",
        "gen_ai.provider.name": "exampleai",
        "gen_ai.request.model": "ex-large-1",
        "gen_ai.token.modality": "unknown",
        "trajectory.observation.point": "provider"
      }
    }
  ]
}
