  "profile": "trajectory.gen_ai.client.token_breakdown@0.1.0",
  "case": "embeddings",
  "description": "An embeddings operation needs no output tokens and raises no missing-cache issue. The absent cache write counts as zero in the arithmetic, so the uncached input is 8 - 0 - 0; it is not recorded as a point of its own.",
