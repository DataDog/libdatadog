      "value": 0,
      "attributes": {
        "gen_ai.operation.name": "embeddings",
        "gen_ai.provider.name": "openai",
        "gen_ai.request.model": "text-embedding-3-small",
        "gen_ai.token.modality": "unknown",
        "trajectory.observation.point": "gateway"
      }
    },
    {
      "name": "trajectory.gen_ai.client.inference.usage.uncached.input_tokens",
      "instrument": "counter",
      "unit": "{token}",
      "value": 8,
      "attributes": {
        "gen_ai.operation.name": "embeddings",
        "gen_ai.provider.name": "openai",
        "gen_ai.request.model": "text-embedding-3-small",
        "gen_ai.token.modality": "unknown",
